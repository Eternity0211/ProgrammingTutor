      "targets": [
        {
          "expr": "sum(rate(programming_tutor_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(programming_tutor_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "title": "HTTP error ratio",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
