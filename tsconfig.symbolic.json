{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "rootDir": ".",
    "outDir": "dist-symbolic",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "src/server/model/symbolic/**/*",
    "tests/server/model/symbolic/**/*"
  ]
}
