{
  "name": "gradeit-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=8192' next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint --config eslint.quality.config.mjs .",
    "lint:multi-agent": "eslint --config eslint.quality.config.mjs src/server/model/dialogue/orchestrator/agent-evidence.ts src/server/model/dialogue/orchestrator/agent-pipeline.ts src/server/model/dialogue/orchestrator/dialogue-orchestrator.ts src/server/model/dialogue/types/agent-results.ts src/server/model/neural/emotionAgent.ts src/server/model/neural/navigationAgent.ts src/server/model/pipeline/submission-evaluation-service.ts src/server/model/prompts/registry.ts tests/server/model/dialogue/agent-evidence.test.ts tests/server/model/dialogue/agent-pipeline.test.ts tests/server/model/dialogue/dialogue-orchestrator.test.ts tests/server/model/pipeline/submission-evaluation-service.test.ts tests/server/model/prompts/registry.test.ts --max-warnings 0",
    "postinstall": "prisma generate",
    "docker:start": "npx prisma migrate deploy && npm run dev",
    "db:seed": "ts-node --project tsconfig.seed.json --transpile-only prisma/seed.ts",
    "build:dataset": "node scripts/build-neural-dataset.mjs",
    "services:wait": "node scripts/wait-for-external-services.mjs",
    "worker:evaluations": "tsx scripts/evaluation-worker.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "node scripts/check-staged-format.mjs",
    "prepare": "husky",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:e2e": "node scripts/run-playwright-e2e.mjs",
    "test:e2e:authenticated": "cross-env RUN_AUTHENTICATED_E2E=1 node scripts/run-playwright-e2e.mjs",
    "test:integration:external": "cross-env RUN_EXTERNAL_INTEGRATION=1 jest tests/integration/external-services.integration.test.ts --runInBand",
    "test:observability": "jest tests/server/observability tests/server/config/production-config.test.ts tests/integration/metrics-api.test.ts --runInBand",
    "test:resilience": "jest tests/server/resilience tests/integration/submission-retry-api.test.ts tests/server/model/pipeline/evaluation-failure.test.ts tests/server/model/pipeline/evaluation-job-service.test.ts tests/server/model/mcp/tool-registry.test.ts --runInBand",
    "test:ai-quality": "jest tests/server/model/prompts tests/server/model/dialogue/rag-engine.test.ts tests/server/model/dialogue/agent-pipeline.test.ts tests/server/model/dialogue/eval-runner.test.ts tests/server/model/mcp/tool-registry.test.ts tests/server/model/pipeline/submission-evaluation-service.test.ts --runInBand",
    "test:multi-agent": "jest tests/server/model/dialogue/agent-evidence.test.ts tests/server/model/dialogue/dialogue-orchestrator.test.ts tests/server/model/pipeline/submission-evaluation-service.test.ts --runInBand",
    "benchmark:agents": "tsx scripts/measure-agent-benefits.ts",
    "benchmark:rag": "tsx scripts/measure-rag-benefits.ts",
    "benchmark:analyze": "node scripts/analyze-benefit-results.mjs",
    "benchmark:blind-review": "node scripts/create-blind-review.mjs",
    "benchmark:human-review": "node scripts/analyze-human-review.mjs",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "validate:dataset": "node scripts/validate-neural-dataset.mjs",
    "validate:dataset:strict": "node scripts/validate-neural-dataset.mjs --require-complete"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@hookform/resolvers": "^3.9.1",
    "@monaco-editor/react": "^4.7.0-rc.0",
    "@prisma/client": "^6.7.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@types/bcrypt": "^5.0.2",
    "@uidotdev/usehooks": "^2.4.1",
    "@use-gesture/react": "^10.3.1",
    "bcrypt": "^6.0.0",
    "better-upload": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.4.7",
    "hugeicons-react": "^0.3.0",
    "input-otp": "^1.4.1",
    "lucide-react": "^0.477.0",
    "markitdown": "^0.0.4",
    "neo4j-driver": "^6.0.1",
    "next": "15.5.26",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.3",
    "nextjs-toploader": "^3.7.15",
    "openai": "^6.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.53.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "web-tree-sitter": "^0.26.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.63.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prisma": "^6.7.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  }
}
