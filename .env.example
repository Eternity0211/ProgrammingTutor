# ====================================
# DATABASE CONFIGURATION
# ====================================
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/gradeit?schema=public"

# ====================================
# AUTHENTICATION (NextAuth.js)
# ====================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-min-32-chars"

# Google OAuth credentials
# Get from: https://console.cloud.google.com/
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
# Optional aliases (if you already use common naming)
# GOOGLE_CLIENT_ID="your-google-oauth-client-id"
# GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ====================================
# JUDGE0 API CONFIGURATION
# ====================================
# Get from: https://rapidapi.com/judge0-official-judge0-official-default/api/judge0-ce
JUDGE0_API_KEY="your-rapidapi-key"
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# ====================================
# AI CONFIGURATION (Local LoRA Model)
# ====================================
# OpenAI-compatible local inference endpoint
# Docker Compose default: http://local-llm:8000/v1
# Local development default: http://localhost:8000/v1
LOCAL_LLM_BASE_URL="http://localhost:8000/v1"

# Model name exposed by local inference service
LOCAL_LLM_MODEL="qwen2.5-7b-instruct-lora"

# API key for local inference service (vLLM/Ollama compatibility)
# If the backend does not enforce a key, keep a non-empty placeholder.
LOCAL_LLM_API_KEY="local-dev-key"

# ====================================
# APPLICATION CONFIGURATION
# ====================================
# Your application URL (used for webhooks and redirects)
# Local development: http://localhost:3000
# Production: https://yourdomain.com
APP_URL="http://localhost:3000"

# Environment
NODE_ENV="development"

# ====================================
# OPTIONAL CONFIGURATION
# ====================================
# Port for local development (default: 3000)
PORT=3000

# Enable debug logging
DEBUG="gradeit:*"

# Rate limiting (requests per minute)
RATE_LIMIT_MAX=25

# Session configuration (in seconds)
SESSION_MAX_AGE=86400

# ====================================
# NOTES FOR DEVELOPERS
# ====================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit the .env file to version control
# 3. All values with "your-" prefix need to be replaced
# 4. Database URL can point to local PostgreSQL or cloud providers (Supabase, Neon, etc.)
# 5. For production, ensure all secrets are strong and unique
# 6. LOCAL_LLM_* variables are required for AI features