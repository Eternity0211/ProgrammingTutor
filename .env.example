# ====================================
# DATABASE CONFIGURATION
# ====================================
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/gradeit?schema=public"
PGVECTOR_ENABLED="false"

# ====================================
# AUTHENTICATION (NextAuth.js)
# ====================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-min-32-chars"

# Google OAuth credentials
# Get from: https://console.cloud.google.com/
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
# Optional aliases (if you already use common naming)
# GOOGLE_CLIENT_ID="your-google-oauth-client-id"
# GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ====================================
# JUDGE0 API CONFIGURATION
# ====================================
# Get from: https://rapidapi.com/judge0-official-judge0-official-default/api/judge0-ce
JUDGE0_API_KEY="your-rapidapi-key"
JUDGE0_API_HOST="judge0-ce.p.rapidapi.com"

# ====================================
# AI CONFIGURATION (Optional)
# ====================================
# Groq API for AI features (test case generation, code evaluation)
# Get from: https://console.groq.com/
GROQ_API_KEY="your-groq-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-flash"

# Optional evaluator-only LLM usage capture (leave disabled for normal runs)
# EVAL_USAGE_LOG="1"
# EVAL_RUN_ID="C-p4-round1"
# Prices are provider/account-specific currency units per 1M tokens.
# EVAL_INPUT_PRICE_PER_1M="0"
# EVAL_OUTPUT_PRICE_PER_1M="0"
# Optional, only required when RAG embeddings are enabled.
EMBEDDING_API_KEY="your-embedding-api-key"
EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
EMBEDDING_MODEL="text-embedding-v3"
RAG_RETRIEVAL_MODE="keyword"

# ====================================
# KNOWLEDGE GRAPH (required in production)
# ====================================
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

# ====================================
# APPLICATION CONFIGURATION
# ====================================
# Your application URL (used for webhooks and redirects)
# Local development: http://localhost:3000
# Production: https://yourdomain.com
APP_URL="http://localhost:3000"

# Environment
NODE_ENV="development"

# ====================================
# OPTIONAL CONFIGURATION
# ====================================
# Port for local development (default: 3000)
PORT=3000

# Enable debug logging
DEBUG="gradeit:*"
TRACE_LOG_PATH="./.data/traces.jsonl"
LOG_LEVEL="info"

# Production trace export (for example OpenTelemetry Collector/Tempo/Jaeger)
OTEL_SERVICE_NAME="programming-tutor"
OTEL_SERVICE_VERSION="local"
# Required in production; leave unset locally to keep using TRACE_LOG_PATH.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318/v1/traces"
# Optional comma-separated OTLP headers: key=value,key2=value2
OTEL_EXPORTER_OTLP_HEADERS=""
OTEL_EXPORTER_TIMEOUT_MS=5000

# Protects /api/metrics. Required in production.
METRICS_TOKEN="replace-with-a-random-monitoring-token"

# Readiness dependency policy: required, optional, or disabled.
HEALTHCHECK_NEO4J="optional"
HEALTHCHECK_JUDGE0="optional"
HEALTHCHECK_LLM="required"
HEALTHCHECK_TIMEOUT_MS=2000

# Set to 1 only when intentionally running tests against real external services.
RUN_EXTERNAL_INTEGRATION="0"

# Rate limiting (requests per minute)
RATE_LIMIT_MAX=25
RATE_LIMIT_WINDOW_MS=60000
DIALOGUE_RATE_LIMIT_MAX=25
SUBMISSION_RATE_LIMIT_MAX=10
MCP_RATE_LIMIT_MAX=60

# External dependency resilience. Values are per application instance.
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_CONCURRENCY=12
DEEPSEEK_MAX_QUEUE=50
DEEPSEEK_CIRCUIT_FAILURE_THRESHOLD=5
DEEPSEEK_CIRCUIT_RESET_MS=30000

EMBEDDING_TIMEOUT_MS=15000
EMBEDDING_MAX_RETRIES=1
EMBEDDING_MAX_CONCURRENCY=6
EMBEDDING_MAX_QUEUE=30

JUDGE0_TIMEOUT_MS=20000
JUDGE0_MAX_CONCURRENCY=8
JUDGE0_MAX_QUEUE=50
JUDGE0_CIRCUIT_FAILURE_THRESHOLD=5
JUDGE0_CIRCUIT_RESET_MS=30000

NEO4J_TIMEOUT_MS=5000
NEO4J_MAX_CONCURRENCY=16
NEO4J_MAX_QUEUE=50
NEO4J_CIRCUIT_FAILURE_THRESHOLD=5
NEO4J_CIRCUIT_RESET_MS=30000

MCP_TOOL_TIMEOUT_MS=30000

# Session configuration (in seconds)
SESSION_MAX_AGE=86400

# ====================================
# NOTES FOR DEVELOPERS
# ====================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit the .env file to version control
# 3. All values with "your-" prefix need to be replaced
# 4. Database URL can point to local PostgreSQL or cloud providers (Supabase, Neon, etc.)
# 5. For production, ensure all secrets are strong and unique
# 6. GROQ_API_KEY is optional but required for AI features
