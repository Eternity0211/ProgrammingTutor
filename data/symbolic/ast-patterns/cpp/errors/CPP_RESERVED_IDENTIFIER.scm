; ==============================================================================
; CPP_RESERVED_IDENTIFIER
; 检测使用 C/C++ 标准保留标识符模式的变量名：
; 1. 以单下划线 + 大写字母开头 (例如 _X, _DEBUG)
; 2. 以双下划线开头 (例如 __impl, __system_var)
;
; 约定：
; - @target：用于定位高亮的标识符节点
; - @name  ：同一节点文本，供 Mapper 在 message 中做 {name} 插值
; ==============================================================================

; ------------------------------------------------------------------------------
; 1. 普通声明：int _X;
; ------------------------------------------------------------------------------
(declaration
  declarator: (identifier) @target @name
  ; 匹配：_X, _FOO, __bar, __BAZ 等
  (#match? @name "^(_[A-Z]|__)")
)

; ------------------------------------------------------------------------------
; 2. 带初始化的声明：int __sys = 0;
; ------------------------------------------------------------------------------
(declaration
  declarator: (init_declarator
    declarator: (identifier) @target @name
  )
  (#match? @name "^(_[A-Z]|__)")
)

