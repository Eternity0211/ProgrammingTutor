; ==============================================================================
; CPP_ARRAY_SIZE_NON_CONSTANT
; 检测数组大小不是简单的编译期常量字面量的情况，例如：
;   int n = 10;
;   int a[n];          // 非标准 C++ 中的变长数组
;
; 约定：
; - @target：size 节点文本，用于高亮
; - @size  ：同一节点文本，供消息中插值（如果需要）
; ==============================================================================

(array_declarator
  size: (_) @target @size
  ; 过滤掉最简单的纯数字常量，如 10、42
  (#not-match? @target "^[0-9]+$")
)

