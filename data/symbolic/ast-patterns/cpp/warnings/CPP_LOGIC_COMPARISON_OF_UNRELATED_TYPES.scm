; ==============================================================================
; CPP_LOGIC_COMPARISON_OF_UNRELATED_TYPES
; 检测指针与整数直接比较（如 ptr == 0 或 ptr < 5），可能为 nullptr 检查或误用。
; 与 0 比较是合法的 nullptr 检查；与非常量整数比较可能有问题。
; ==============================================================================

(binary_expression
  operator: ["==" "!=" "<" ">" "<=" ">="]
  left: (_) @left
  right: (_) @right
) @target
; 一侧为指针形式（* 或 identifier 可能为指针），另一侧为纯数字（非 0）
(#match? @target "\\*|->")
(#match? @target "\\b[1-9]\\d*\\b")